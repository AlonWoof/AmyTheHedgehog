  clothedModel: {fileID: 6167180620624310504}
  nudeModel: {fileID: 6167180619499872874}
  AmyIntroMessage:
    messages:
    - Ah, what a beautiful sunset~
    - '...it''s a shame that something so beautiful

      is so temporary. But,
      I guess that adds to its beauty.'
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  CreamIntroMessage:
    messages:
    - Pretty sunset, huh?
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  AmyMessages:
  - messages:
    - 'Those robots were mean, huh?

      I wonder why Eggman sent them here...'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - 'Y''know, I can''t help but feel nostalgic

      at this time of day. Is that
      weird?'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  CreamMessages:
  - messages:
    - 'Feel free to watch the sunset with me

      any time you want, usagi-chan.'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - 'You''re a very precious bunny.

      I''m sure Amy will protect you.'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  randomOrder: 1
  naked: 0
