    - 'Giiirl, you look so strong~!

      Do you swing a hammer around all day?'
    - 'I need to get in shape, too!

      Then I can finally beat my wife at arm
      wrestling!'
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
