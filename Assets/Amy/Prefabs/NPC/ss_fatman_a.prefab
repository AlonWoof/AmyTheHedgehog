  CreamMessage:
    speakerName: 
    bustImage: {fileID: 0}
    label: 
    messages:
    - 'Ah, hello there, little miss.

      Did you know my building is the tallest
      in Station Circle?'
    - What? You want to go to the roof?
    - '       I''m sorry, but I can''t in good faith let such a little

      girl
      go up there. The strong winds would blow you away!'
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1138561951958289304}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
          m_MethodName: SetTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
