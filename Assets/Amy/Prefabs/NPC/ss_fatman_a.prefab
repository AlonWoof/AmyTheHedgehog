  m_Name: 
  m_EditorClassIdentifier: 
  mDirection: {x: 0, y: 0, z: 0}
  speakerProfile: 0
  AmyMessage:
    speakerName: 
    bustImage: {fileID: 0}
    label: 
    messages:
    - "Well, hello there miss! \nMy building is the tallest in all of Station Circle!"
    - "Feel free to take the elevator so you can \nenjoy the amazing view! Wahahahaha!"
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1138561951958289304}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
