  m_Script: {fileID: 11500000, guid: af025150665b58a47902a2dda82eb63c, type: 3}
  m_Name: SuikaAmyTips
  m_EditorClassIdentifier: 
  profile: 4
  messages:
  - label: Bracers
    messages:
    - 'Why do I wear these gold bracers?

      They''re training weights.'
    - 'They help me keep my strength up

      even when I''m doing a relaxed job
      like this.'
    - "Gotta keep my badass figure to scare \noff potential shoplifters~ "
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: Alcohol
    messages:
    - 'No, you can''t have any of the

      liqour on the shelf behind me.'
    - 'You''re way too young to drink.

      Underage drinking can kill you.'
    - 'I wanna see your cute face in

      here every day, after all.'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: FurColor
    messages:
    - 'Yeah, my fur color is natural.

      Is your pink fur natural, too?'
    - 'We''re both cute and colorful.

      That''s why all the girls adore us~'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: DailyEvents
    messages:
    - 'Did you know some places in

      this world change based on day?'
    - 'Try looking around even in places

      you''re familiar with. You never
      know.'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: ChestWrap
    messages:
    - 'Why do I wear a wrap around my chest?

      Bit of a personal question, no?'
    - 'Well, you''re a cutie, so I''ll tell you.

      It''s a good luck charm.'
    - 'I won my first tournament fight as a preteen.

      This wrap was there to
      protect my sensitive chest.'
    - I've worn it and not much else ever since.
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: SchoolDays
    messages:
    - 'Gosh, what a cute hedghehog girl...

      You must be really popular at school,
      huh?'
    - 'I wasn''t popular. I was a dumb punk

      that kept beating everyone up. '
    - Don't be like me, OK?
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: YumeChan
    messages:
    - 'Do you know my friend Yume-chan?

      She''s a little girl around your age.'
    - 'She never buys anything, but she always

      comes in to see how I''m doing.'
    - She's a very sweet, but very mysterious girl.
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - label: Choker
    messages:
    - 'The choker I wear around my neck

      has a "fire gem" in it. '
    - 'It allows me to do fire magic more easily

      using its concentrated essence.'
    - It's great for when I feel like barbecue for dinner~
    voice: {fileID: 0}
    voice_pitch: 0
