        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - "I hate dirty places. \nGetting dirt in my fur is the worst."
    - "How can I be cute and sexy if \nI smell like grime and sewage?"
    voice: {fileID: 8300000, guid: cc77d37d81660db469b8f5277e91a333, type: 3}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - "I wonder when we'll go home?\nThere's gotta be a way out of here...\t"
    voice: {fileID: 8300000, guid: 7613b61fc012a3c4bb52db43fd04f568, type: 3}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - "Y'know, it's weird how I'm naked, \nbut no one seems to mind."
    - 'I guess the boys go naked all the time in our world.

      So it would be
      "gender equality", right?'
    - It does feel liberating, though!
    voice: {fileID: 8300000, guid: c773fabb783c0034ab410cc503873d72, type: 3}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
