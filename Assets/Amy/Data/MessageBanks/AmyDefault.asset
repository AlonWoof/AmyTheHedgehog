        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - That girl in yellow seems familiar.
    - "Have we met her before? \nHave I met her before?"
    voice: {fileID: 8300000, guid: 7613b61fc012a3c4bb52db43fd04f568, type: 3}
    voice_pitch: 0
    onStartMessage:
