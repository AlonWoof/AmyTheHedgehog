      propertyPath: SimpleMessage.messages.Array.data[0]
      value: 'This Nexus area is long overdo for a remake.

        The thing is,
        I can''t think of any ideas for it.'
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[1]
      value: 'I wanna make something liminal and dreamlike.

        Maybe I should
        study SHAFT studio''s backgrounds.'
      objectReference: {fileID: 0}
    - target: {fileID: 6748699536432002034, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6748699536432002034, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[0]
      value: 'I want to remake this nexus area,

        but I''m not sure how to
        do it just yet...'
      objectReference: {fileID: 0}
    - target: {fileID: 6748699536432002034, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[1]
      value: 'I wanna make something liminal and dreamlike.

        Maybe I should
        study SHAFT studio''''s backgrounds.'
