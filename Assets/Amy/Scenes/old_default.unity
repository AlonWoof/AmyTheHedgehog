      propertyPath: AmyIntroMessage.messages.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: CreamIntroMessage.messages.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyIntroMessage.messages.Array.data[0]
      value: Hello Amy-chan.
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyIntroMessage.messages.Array.data[1]
      value: 'Apparently, you accessed a level that isn''t

        in this build
        of the game. Sorry about that.'
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyIntroMessage.messages.Array.data[2]
      value: 'The door behind me should take you back home. '
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: CreamIntroMessage.messages.Array.data[0]
      value: Hello, Cream.
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: CreamIntroMessage.messages.Array.data[1]
      value: 'You found a level that isn''t in this build.

        Please  use the
        door behind me.'
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: CreamIntroMessage.messages.Array.data[2]
      value: Also, tell Amy onee-san I said "Hi!"
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyMessages.Array.data[1].messages.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyMessages.Array.data[0].messages.Array.data[0]
      value: 'This grass plane is infinite. Feel free to run

        around as much
        as you''d like.'
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyMessages.Array.data[1].messages.Array.data[0]
      value: 'I wonder what my motivations are?

        Not even Jennifer knows
        yet.'
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: AmyMessages.Array.data[1].messages.Array.data[1]
      value: But be assured, I love you.
      objectReference: {fileID: 0}
    - target: {fileID: 6437706314849156921, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
      propertyPath: CreamMessages.Array.data[0].messages.Array.data[0]
      value: 'Weird how a random NPC became an important

        character, huh?
        It''s like a metaphor or something.'
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 341191200458ade47bb96d3aab32f32c, type: 3}
