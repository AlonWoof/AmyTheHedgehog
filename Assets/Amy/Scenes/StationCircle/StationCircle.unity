    - target: {fileID: 4680238853722287462, guid: 053124d1e88fbb64bb05cf4e94329496, type: 3}
      propertyPath: globalMessage.messages.Array.data[1]
      value: 'It''s meant to be familiar, but different.

        As for the name,
        well...'
      objectReference: {fileID: 0}
    - target: {fileID: 4680238853722287462, guid: 053124d1e88fbb64bb05cf4e94329496, type: 3}
      propertyPath: globalMessage.messages.Array.data[2]
      value: 'My wife called it "Station Circle" as a joke,

        and the name
        stuck. It was too cute to pass up.'
      objectReference: {fileID: 0}
