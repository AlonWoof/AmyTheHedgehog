    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[1]
      value: 'The deep water with an infinite void underneath

        combined with
        bad collision terrifies me.'
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[2]
      value: 'But, it''s also a very nostalgic level for me that

        makes me
        feel all warm and fuzzy.'
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[3]
      value: 'I often have dreams about this place, and this

        version of
        the iconic beach will resemble them.'
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[5]
      value: 'Emerald Coast has always been weird

        for me. Like, both nostalgic
        and unsettling.'
      objectReference: {fileID: 0}
    - target: {fileID: 6748699536432002034, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
