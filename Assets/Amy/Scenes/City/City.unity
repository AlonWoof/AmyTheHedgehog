  clothedModel: {fileID: 1352285002}
  nudeModel: {fileID: 1784265436}
  AmyIntroMessage:
    messages:
    - 'Do you ever feel like you''re in a dream,

      even though you''re wide
      awake?'
    - ...Sorry if that's a weird thing to say.
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  CreamIntroMessage:
    messages:
    - 'What a cute bunny. I bet you could use

      those big ol ears of yours to
      fly!'
    - Ganbatte, usagi-chan!
    voice: {fileID: 0}
    voice_pitch: 1
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  AmyMessages:
  - messages:
    - 'Isn''t it weird how it''s always sunset here?

      Let''s hope it stays
      that way...'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - 'This place really makes me feel at home.

      How about you? Do you like
      it here?'
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  CreamMessages:
  - messages:
    - 'Wow, that building in the north side

      is HUGE. I can''t even see the
      top!'
    - I bet the elevator rides take forever.
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - 'Make sure to get plenty of rest.

      Also, eat some good food. '
    - It's important!
    voice: {fileID: 0}
    voice_pitch: 0
    onStartMessage:
      m_PersistentCalls:
        m_Calls: []
    onEndMessage:
      m_PersistentCalls:
        m_Calls: []
    onStartPrint:
      m_PersistentCalls:
        m_Calls: []
    onEndPrint:
      m_PersistentCalls:
        m_Calls: []
  randomOrder: 1
  naked: 0
