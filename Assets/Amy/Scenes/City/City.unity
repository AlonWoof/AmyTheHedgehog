    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[0]
      value: "The concept of Station Circle was \n\"station square from a dream\""
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[1]
      value: 'The layout is different and everything is off.

        Also, there''s
        a lot more women.'
      objectReference: {fileID: 0}
    - target: {fileID: 2185919587258823278, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
      propertyPath: SimpleMessage.messages.Array.data[2]
      value: 'My girlfriend called it "Station Circle" as a joke.

        Needless
        to say, the name stuck.'
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 23abcd3a8f8afa54a9538b49c4cea271, type: 3}
