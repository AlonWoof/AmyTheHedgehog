    - target: {fileID: 4765440909205242302, guid: b37cf319c3d7577458f92434d67a8c74, type: 3}
      propertyPath: AmyMessage.messages.Array.data[1]
      value: "Careful near the edge, m'dear!\n             Wahahahahaaa!"
      objectReference: {fileID: 0}
    - target: {fileID: 4765440909205242302, guid: b37cf319c3d7577458f92434d67a8c74, type: 3}
      propertyPath: CreamMessage.messages.Array.data[0]
